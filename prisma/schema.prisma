// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/generated"
}
// Output due to error: https://github.com/prisma/prisma/discussions/23223#discussioncomment-12925452

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// App models

enum ResetType {
  DAILY
  WEEKLY
}

model User {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  todos        Todo[]
}

model Todo {
  id        String   @id @default(cuid())
  userId    String
  text      String
  done      Boolean  @default(false)
  order     Int      @default(0)
  // Per-item reset schedule
  resetType ResetType @default(DAILY)
  // For DAILY, reset at HH:00 local time (0-23)
  resetHour Int?      @default(9)
  // For WEEKLY, day of week 0-6 (0=Sunday)
  resetDow  Int?
  // When the todo's done/undone status last changed
  statusChangedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
